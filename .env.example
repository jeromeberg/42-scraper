# Paste your full Cookie header value from the browser here.
# In DevTools > Network tab, pick any request to projects.intra.42.fr,
# copy the "Cookie:" request header value, and paste it below.
INTRA_COOKIE=_intranet_session=YOUR_COOKIE_VALUE_HERE

# Optional: Ollama endpoint and model for AI enhancement
OLLAMA_ENDPOINT=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
